# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Logs
logs/*.log

# Lokale Zwischenspeicher (z.B. Google-Places-Flächensuche, enthält Google-Inhalte)
data/*
# Ausnahme Spielplatz-Guide: die vom Auftraggeber gepflegten Entscheidungsdateien sind eingecheckt
# (Plan 3.1/4.6); Stadtdateien, OSM-Zwischenspeicher und Prüf-CSV bleiben lokal.
!data/spielplaetze/
data/spielplaetze/*
!data/spielplaetze/korrekturen.csv
!data/spielplaetze/abenteuer.csv
!data/spielplaetze/ausstattung.csv
# Ausnahme Weihnachtsmarkt-Guide (Plan docs/plan-weihnachtsmaerkte-2026-11-17.md, 3.2): gepflegte Stammdaten eingecheckt;
# Toubiz-Zwischenspeicher, Entwurf, Prüf-CSV und Score-Bericht (Google-Rohwerte, E12) bleiben lokal.
!data/weihnachtsmaerkte/
data/weihnachtsmaerkte/*
!data/weihnachtsmaerkte/maerkte.csv
!data/weihnachtsmaerkte/saison-2026.csv
!data/weihnachtsmaerkte/merkmale.csv
!data/weihnachtsmaerkte/event_ausschluss.csv
!data/weihnachtsmaerkte/bilder.csv
!data/weihnachtsmaerkte/kleine_maerkte.csv
!data/weihnachtsmaerkte/event_einschluss.csv
# Ausnahme Ortsseiten (Plan docs/plan-locations-2026-11-18.md, Schritt 1): Kandidatenliste zur Sichtung eingecheckt
!data/spielstaetten/
data/spielstaetten/*
!data/spielstaetten/kandidaten.csv
# Schritt 3: eigene Bilder und freigegebene Texte der Ortsseiten (Plan 3.13, 3.14)
!data/spielstaetten/bilder.csv
!data/spielstaetten/texte.csv

# Playwright
playwright/.auth/

# macOS
.DS_Store

# Kartendaten (OpenStreetMap-Ausschnitt, ~50 MB) – wird separat auf den Server gebracht, nicht über Git
web/public/karte/*.pmtiles

# Supabase-CLI (tools/supabase-cli): Token-Datei und lokaler Link-Zustand nie ins Repo
secrets/*.env
supabase/.temp/
tools/supabase-cli/node_modules/
