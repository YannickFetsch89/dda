# DiesDasDüsseldorf – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und fülle alle Werte aus
# NIEMALS die .env Datei in Git committen!

# Supabase
SUPABASE_URL=https://dein-projekt.supabase.co
# anon-Key: nur Lesen + Login (Dashboard, Website)
SUPABASE_KEY=dein-supabase-anon-key
# service_role-Key: nur für die Pipeline (schreibt Events, umgeht RLS) – streng geheim
SUPABASE_SERVICE_KEY=dein-supabase-service-role-key

# Claude / Anthropic (Texterstellung & Kategorisierung)
ANTHROPIC_API_KEY=sk-ant-...

# Meta (Instagram + Facebook) – nur lokal für tools/meta_pruefen.py (Plan docs/plan-social-2026-11-25.md, Schritt 0).
# Auf dem Server schreibt deploy.yml den Token nach web/.env.local; nie in einen GitHub-Job.
META_TOKEN=systembenutzer-token
META_PAGE_ID=id-der-facebook-seite
META_IG_ID=id-des-instagram-kontos

# Event-APIs
TICKETMASTER_API_KEY=dein-ticketmaster-api-key
EVENTBRITE_TOKEN=dein-eventbrite-oauth-token
MEETUP_API_KEY=dein-meetup-api-key
SONGKICK_API_KEY=dein-songkick-api-key

# Google Places API (Restaurant-Recherche, Fotos)
GOOGLE_PLACES_API_KEY=dein-google-places-api-key

# Logging
LOG_LEVEL=INFO
