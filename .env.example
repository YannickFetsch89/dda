# DiesDasDüsseldorf – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und fülle alle Werte aus
# NIEMALS die .env Datei in Git committen!

# Supabase
SUPABASE_URL=https://dein-projekt.supabase.co
SUPABASE_KEY=dein-supabase-anon-key

# Claude / Anthropic (Texterstellung & Kategorisierung)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (DALL-E 3 – Fallback-Bildgenerierung)
OPENAI_API_KEY=sk-...

# Instagram Graph API (direkt – kein Drittanbieter)
INSTAGRAM_ACCESS_TOKEN=dein-instagram-access-token
INSTAGRAM_ACCOUNT_ID=deine-instagram-account-id

# Event-APIs
TICKETMASTER_API_KEY=dein-ticketmaster-api-key
EVENTBRITE_TOKEN=dein-eventbrite-oauth-token
MEETUP_API_KEY=dein-meetup-api-key
SONGKICK_API_KEY=dein-songkick-api-key

# Logging
LOG_LEVEL=INFO
