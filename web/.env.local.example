# DiesDasDüsseldorf Website – lokale Umgebungsvariablen
# Kopiere diese Datei als .env.local und trage die Werte ein (gleiche wie in der Python-.env).
# .env.local wird nie committet. Die Keys werden nur serverseitig genutzt.

SUPABASE_URL=https://dqckcszxoyaxiwwcgxxk.supabase.co
SUPABASE_KEY=dein-supabase-anon-key

# Öffentliche Basis-URL (für Open-Graph-Links)
SITE_URL=https://diesdas.events

# Google Search Console: Inhalt des Meta-Tags "google-site-verification" (optional)
GOOGLE_SITE_VERIFICATION=
